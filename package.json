{
  "name": "daytrack",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "concurrently -n web,worker \"pnpm dev:web\" \"pnpm dev:worker\"",
    "dev:web": "next dev",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prisma": "prisma",
    "recap:generate": "tsx src/worker/recap.ts",
    "sessions:cleanup": "tsx src/worker/sessions.ts"
  },
  "dependencies": {
    "@prisma/client": "6.11.1",
    "@tanstack/react-query": "5.81.5",
    "date-fns": "4.1.0",
    "lucide-react": "0.525.0",
    "next": "16.2.12",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.59.0",
    "sharp": "0.34.2",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@playwright/test": "1.53.1",
    "@tailwindcss/postcss": "4.1.10",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.15.32",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "concurrently": "9.2.0",
    "eslint": "9.29.0",
    "eslint-config-next": "16.2.12",
    "jsdom": "26.1.0",
    "postcss": "8.5.6",
    "prisma": "6.11.1",
    "tailwindcss": "4.1.10",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
